# Copy to `server/functions/.env` and fill in. Firebase Functions loads this
# file automatically at deploy time. The real file is gitignored — never
# commit it.

# --- Security -----------------------------------------------------------

# Comma-separated list of origins allowed to call the API with credentials.
# Leave unset to fall back to the first-party allowlist baked into app.ts.
# Never set this to "*" — the session cookie is credentialed.
CORS_ORIGINS=https://college.codesapiens.in,https://admin.codesapiens.in

# Set to "true" once every client sends App Check tokens. Enforcement is off
# by default so existing clients keep working.
ENFORCE_APP_CHECK=false

# Revoke-checking on every ID token verification. Costs an extra lookup per
# request; worth it if you need instant session revocation.
CHECK_REVOKED_TOKENS=false

# --- CTF ----------------------------------------------------------------

# REQUIRED for the CTF to run in production. Every flag is derived from this
# via HMAC, so the flags change if you rotate it and previously-earned flags
# stop validating. Generate with:
#
#   openssl rand -hex 32
#
# Without it the CTF serves 503 rather than running on a guessable secret.
CTF_FLAG_SECRET=

# Advertised in the X-Codesapiens-Challenge header on API responses. Only
# needs setting if the CTF function moves.
CTF_PUBLIC_URL=https://asia-south1-collegesapiens.cloudfunctions.net/ctf

# --- Email (AWS SES) ----------------------------------------------------

AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SES_SENDER_EMAIL=noreply@codesapiens.in

# --- Misc ---------------------------------------------------------------

COOKIE_MAX_AGE_DAYS=5
